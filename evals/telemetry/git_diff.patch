      assert.ok(isValidBlockedBy,
        `[${key}/${node.step}] blockedBy deve ser null, string ou string[]`);
      assert.ok(node.next === null || typeof node.next === 'string',
        `[${key}/${node.step}] next deve ser string ou null`);
