    step: 'planejar', role: 'plan-architect',
    blocks: [], blockedBy: 'clarificar', next: 'aprovar',
  },
  {
    // blocks vazio de propósito — aprovação é trava estrutural (Decisão D-F1)
    step: 'aprovar', role: 'final-validator',
