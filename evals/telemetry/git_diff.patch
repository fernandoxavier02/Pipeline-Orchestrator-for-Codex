  assert.ok('nextStep' in json2, 'deve ter campo nextStep');
});

// ─── T-IO-27b: dry-run campos corretos ───────────────────────────────────────

test('T-IO-27b: grow-tree CLI — dry-run: campos step e title presentes, issueId ausente ou null', async () => {
