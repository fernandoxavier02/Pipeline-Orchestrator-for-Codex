    'ADVERSARIAL_CONSOLIDATED', 'ADVERSARIAL_CONSOLIDATED_CORRECTION',
    'SECURITY_FINDINGS', 'QUALITY_FINDINGS', 'ARCHITECTURE_FINDINGS', 'SECURITY_RERUN_FINDINGS',
