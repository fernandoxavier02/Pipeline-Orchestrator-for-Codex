{
  "name": "pipeline-orchestrator-for-codex",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "bin": {
    "pipeline": "./dist/src/cli/pipeline-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pipeline-contracts": "vitest run tests/integration/claude-v710-parity.test.ts tests/unit/protocol/protocol-events.test.ts tests/unit/modes/mode-policy.test.ts tests/unit/controller/plan-mode.test.ts tests/unit/controller/pipeline-controller.test.ts tests/unit/execution/executor-parity-contract.test.ts tests/integration/execution/controller-routing.test.ts tests/integration/review/review-independence.test.ts --testTimeout 30000",
    "watchdog:pipeline-contracts": "node scripts/pipeline-contract-watchdog.mjs",
    "lint:types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "yaml": "^2.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
