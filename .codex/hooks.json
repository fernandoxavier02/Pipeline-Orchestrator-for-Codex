{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/pre_tool_use_policy.py",
            "timeout": 30,
            "statusMessage": "Checking Eval Gate command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/post_tool_use_telemetry.py",
            "timeout": 30,
            "statusMessage": "Capturing Eval Gate telemetry"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/stop_eval_gate.py",
            "timeout": 60,
            "statusMessage": "Running Eval Gate"
          }
        ]
      }
    ]
  }
}
