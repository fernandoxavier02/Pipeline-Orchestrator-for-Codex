{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-lock-hook.cjs\""
          },
          {
            "type": "prompt",
            "prompt": "Pipeline Orchestrator for Codex v0.4.1 loaded. Parity target: Claude Code Pipeline Orchestrator v4.1.0-rc.1 (session-lock, dispatch-guard, edit-guard middleware, sentinel checkpoints 1–5, atomic stores, session-cleanup, execution identity tracing). Try: /pipeline [task] for full execution, /pipeline diagnostic [task] to preview without executing, /pipeline --grill [task] for design interrogation, /pipeline --hotfix [task] for emergency bypass. Config: create .codex/pipeline.local.md to set build/test commands (optional — auto-detection available)."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/force-pipeline-agents.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/completion-checklist.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-cleanup-hook.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sentinel-hook.cjs\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          }
        ]
      }
    ]
  }
}
