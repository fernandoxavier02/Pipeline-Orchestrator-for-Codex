{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/session-lock-hook.cjs\""
          },
          {
            "type": "prompt",
            "prompt": "Pipeline Orchestrator for Codex v0.4.1 loaded. Parity target: local Claude Code Pipeline Orchestrator v5.2.0 (strict real-agent dispatch, GATE_REQUEST/DISPATCH_REQUEST/PLAN_MODE_REQUEST protocol-events.jsonl, brainstorm pipeline-runs, Spec lifecycle gates, TRACE.md, session-lock, dispatch/edit guards, sentinel checkpoints, atomic stores, cleanup, execution identity tracing). Try: /pipeline-orchestrator-for-codex:pipeline [task] for strict execution, /pipeline-orchestrator-for-codex:pipeline diagnostic [task] to preview, or /pipeline-orchestrator-for-codex:brainstorm [task] for preparation. Without spawn_agent, operational pipeline execution blocks with blocked-no-agent-runtime instead of simulating multi-agent execution."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/force-pipeline-agents.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/session-lock-hook.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/completion-checklist.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/session-cleanup-hook.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/sentinel-hook.cjs\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/hooks/edit-guard-hook.cjs\""
          }
        ]
      }
    ]
  }
}
