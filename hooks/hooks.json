{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-start-context.cjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/force-pipeline-agents.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-lock-hook.cjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/completion-checklist.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/session-cleanup-hook.cjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "spawn_agent|wait_agent|update_plan",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sentinel-hook.cjs\""
          }
        ]
      },
      {
        "matcher": "wait_agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "update_plan",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/sentinel-hook.cjs\""
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/dispatch-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/edit-guard-hook.cjs\""
          }
        ]
      }
    ]
  }
}
